{
  "workspace": [
    "./apps/api",
    "./apps/spa",
    "./apps/mpa",
    "./apps/worker",
    "./libs/platform/cqrs",
    "./libs/domain/groups"
  ],
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@tailwindcss/oxide@4.1.12"],
  "tasks": {
    "dev": "deno run compose up -d", // used in terminal to start the development environment
    "build": "deno task spa:build", // used in terminal to build production docker images

    // #region apps/api
    "api:dev": "deno serve --allow-all --watch apps/api/index.ts", // used in docker-compose to start the API server in development mode
    "api:prod": "deno serve --allow-all apps/api/index.ts", // production mode - no watch
    // #endregion apps/api

    // #region apps/spa
    "spa:dev": "deno task --cwd apps/spa dev", // used in docker-compose to start the SPA in development mode
    "spa:build": "deno task --cwd apps/spa build",
    // #endregion apps/spa

    // #region apps/mpa
    "mpa:dev": "deno task --cwd apps/mpa dev",
    "mpa:build": "deno task --cwd apps/mpa build",
    "mpa:start": "deno task --cwd apps/mpa start",
    "mpa:check": "deno task --cwd apps/mpa check",
    // #endregion apps/mpa

    // #region Scripts
    "db:migrate": "deno run -N=$DB_HOST:5432 -E -R=./libs/server/db/migrations ./libs/server/db/migrate.ts",
    "db:seed": "deno run -N=$DB_HOST:5432,$KV_HOSTNAME:6379 -E -R=infra/envs/.env infra/scripts/seed-data.ts",
    "deps:check": "deno outdated -r",
    "deps:update": "deno outdated -r -u -i",
    "update:ubuntu": "sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y && sudo apt clean && sudo apt --fix-broken install && sudo do-release-upgrade",
    "vapid-key:create": "deno run -W=infra/configs/vapid.json --allow-run=deno ./infra/scripts/vapid-keys-create.ts",
    "compose": "deno run -R=./infra --allow-run=docker,podman ./infra/scripts/compose.ts",
    "proxy:start": "docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env up -d",
    "proxy:stop": "docker compose -f ./infra/compose/compose.proxy.yml --env-file ./infra/envs/.env down",
    "deploy": "deno run -R=./infra --allow-run=rsync,ssh ./infra/scripts/deploy.ts",
    // #endregion Scripts

    // #region Checks
    "check": {
      "command": "echo 'Checks passed!'",
      "description": "Run all checks",
      "dependencies": [
        "lint:check",
        "fmt:check",
        "ts:check",
        "test"
      ]
    },
    "fmt:fix": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:check": "deno lint",
    "ts:check": "deno run --allow-read --allow-run=deno infra/scripts/type-check.ts",
    "test": "deno test --no-prompt libs/shared libs/domain tests/auth tests/cqrs tests/groups tests/middlewares",
    "test:integration": "ENV=test deno test --no-prompt -E -N -R=./libs/server/db/migrations,./libs/server/db/schema.sql libs/server/db tests/integration",
    "e2e": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright test",
    "e2e:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=./e2e/report deno run -A --node-modules-dir npm:playwright show-report",
    "fix": {
      "command": "echo 'Fixes applied!'",
      "description": "Run all fixes",
      "dependencies": [
        "lint:fix",
        "fmt:fix"
      ]
    },
    "fix-n-check": {
      "command": "echo 'Fixes applied and checks passed!'",
      "description": "Run all fixes and checks",
      "dependencies": [
        "fix",
        "check"
      ]
    },
    // #endregion Checks

    // #region Git Hooks
    "hooks:install": "deno run -R=deno.json,deno.jsonc,.git/hooks/ -W=.git/hooks/ jsr:@hongminhee/deno-task-hooks",
    "hooks:pre-commit": "deno task check"
    // #endregion Git Hooks
  },
  "imports": {
    // #region Aliases
    "@api/services/": "./apps/api/services/",
    "@api/middlewares/": "./apps/api/middlewares/",
    "@api/cqrs/": "./apps/api/cqrs/",
    "@spa/state/": "./apps/spa/src/state/",
    "@spa/components/": "./apps/spa/src/components/",
    "@shared/types": "./libs/shared/types/+index.ts",
    "@shared/constants/": "./libs/shared/constants/",
    "@shared/helpers/": "./libs/shared/helpers/",
    "@shared/testing": "./libs/shared/testing/+index.ts",
    "@platform/cqrs/": "./libs/platform/cqrs/",
    "@domain/groups": "./libs/domain/groups/+lib.ts",
    "@shared/local-storage": "./libs/shared/local-storage/+index.ts",
    "@shared/cache": "./libs/shared/cache/+index.ts",
    "@shared/rpc": "./libs/shared/rpc/+index.ts",
    "@server/db": "./libs/server/db/+index.ts",
    "@server/kv": "./libs/server/kv/+index.ts",
    "@server/helpers/": "./libs/server/helpers/",
    "@server/groups/": "./libs/server/groups/",
    "@client/preact/": "./libs/client/preact/",
    "@client/vite/": "./libs/client/vite/",
    "@client/browser": "./libs/client/browser/+index.ts",
    "@client/helpers": "./libs/client/helpers/+index.ts",
    "@client/icons": "./libs/client/icons/+index.tsx",
    // #endregion Aliases

    // #region Dependencies
    // apps/api
    "hono": "jsr:@hono/hono@^4.7.7",
    "@hectorm/otpauth": "jsr:@hectorm/otpauth",
    "qrcode": "jsr:@libs/qrcode@^3.0.0",
    "webpush": "jsr:@negrel/webpush",

    // apps/tgbot

    // client
    "preact": "npm:preact@10.28.2",
    "wouter-preact": "npm:wouter-preact@3.9.0",
    "@preact/signals": "npm:@preact/signals@2.5.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",

    // shared
    "@std/path": "jsr:@std/path@^1.0.3",
    "@std/expect": "jsr:@std/expect@^1.0.15",
    "@std/testing": "jsr:@std/testing@^1.0.11",
    "@std/encoding": "jsr:@std/encoding@^1.0.5",
    "@playwright/test": "npm:@playwright/test@^1.57.0",
    "playwright": "npm:playwright@^1.57.0",

    // shared/types
    "arktype": "npm:arktype@^2.1.29",

    // server/kv
    "@iuioiua/redis": "jsr:@iuioiua/redis@^1.1.10",

    // server/db
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js"
    // #endregion Dependencies
  },
  "exclude": [
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "infra",
    "*.lock"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  },

  // #region Preact Configs
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
  // #endregion Preact Configs
}
