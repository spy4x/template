# The MPA: Fresh, built into the image and served by Deno. Build context is the repository root.
ARG DENO_VERSION=2.9.0
FROM app/deno-base:${DENO_VERSION}

USER root
COPY --chown=1000:1000 . .
USER 1000:1000

RUN deno task mpa:build

EXPOSE 8080
CMD ["deno", "serve", "--allow-all", "--port", "8080", "apps/mpa/_fresh/server.js"]
